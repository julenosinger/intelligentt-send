# Environment variables for Intelligent Send
# Copy to .env and fill in values

# API settings
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./intelligent_send.db

# GenLayer settings
GENLAYER_RPC=https://rpc-bradbury.genlayer.com
GENLAYER_NETWORK=studio  # or "bradbury"
GENLAYER_ACCOUNT_PK=your_private_key_here
GENLAYER_RISK_CONTRACT=0x...  # deploy your RiskAnalyzer contract
GENLAYER_SMART_TRANSFER_CONTRACT=0x...  # deploy your SmartTransfer contract
GENLAYER_MOCK=0  # set to 1 to use mock responses when GenLayer is down

# Arc settings
ARC_RPC=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Chain RPCs (comma-separated per chain_id)
CHAIN_RPC_5042002=https://rpc.testnet.arc.network
CHAIN_RPC_11155111=https://rpc.sepolia.org
CHAIN_RPC_421614=https://sepolia-rollup.arbitrum.io/rpc
CHAIN_RPC_84532=https://sepolia.base.org
CHAIN_RPC_11155420=https://sepolia.optimism.io
CHAIN_RPC_80002=https://rpc-amoy.polygon.technology

# Faucet info
AR_FAUCET=https://faucet.circle.com
GENLAYER_FAUCET=https://testnet-faucet.genlayer.foundation