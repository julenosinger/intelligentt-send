# Environment variables for Intelligent Send
# Copy to .env and fill in values (do NOT commit .env)

# API settings
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./intelligent_send.db

# GenLayer settings
# GENLAYER_NETWORK: bradbury | studio | studio-dev | localnet
GENLAYER_NETWORK=studio
GENLAYER_ACCOUNT_PK=your_private_key_here
GENLAYER_RISK_CONTRACT=0x...  # deploy with scripts/deploy_genlayer.py
GENLAYER_MOCK=0  # set to 1 to serve mock analysis instead of hitting GenLayer

# Arc settings
ARC_RPC=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Faucet info
ARC_FAUCET=https://faucet.circle.com
GENLAYER_FAUCET=https://testnet-faucet.genlayer.foundation
